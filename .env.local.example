# Supabase – copia questo file in .env.local e compila i valori reali
# NON committare .env.local su git

# URL del progetto Supabase (Settings → API → Project URL)
VITE_SUPABASE_URL=https://INSERISCI_QUI.supabase.co

# Anon key (Settings → API → anon/public)
VITE_SUPABASE_ANON_KEY=eyJ...

# Service Role Key – necessaria per lo script di upload
# (Settings → API → service_role – TIENILA SEGRETA)
VITE_SUPABASE_SERVICE_KEY=eyJ...
